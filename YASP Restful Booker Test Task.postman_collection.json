						"value": "token={{token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"firstname\": \"Josh\",\r\n    \"lastname\": \"Smith\",\r\n    \"totalprice\": \"300\",\r\n    \"depositpaid\": \"abc\",\r\n    \"bookingdates\": {\r\n        \"checkin\": \"10/10/2026\",\r\n        \"checkout\": \"10/20/2026\"\r\n    },\r\n    \"additionalneeds\": \"\"\r\n}"
				},
				"url": {
					"raw": "{{RestfulBookerURL}}/booking/11",
					"host": [
						"{{RestfulBookerURL}}"
					],
					"path": [
						"booking",
						"11"
					]
				}
			},
			"response": []
