	"item": [
		{
			"name": "Auth - Create Token",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status 200', function(){pm.response.to.have.status(200);});",
							"var j=pm.response.json();",
							"if(j.token){pm.collectionVariables.set('token', j.token);}"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"username\": \"admin\",\r\n    \"password\": \"password123\"\r\n}"
				},
				"url": {
					"raw": "{{RestfulBookerURL}}/auth",
					"host": [
						"{{RestfulBookerURL}}"
					],
					"path": [
						"auth"
					]
				}
			},
			"response": []
		},
		{
			"name": "Create Booking",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Booking created', function(){pm.expect(pm.response.code).to.be.oneOf([200,201]);});",
							"var j=pm.response.json();",
							"if(j.bookingid){pm.collectionVariables.set('bookingId', j.bookingid);}"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"firstname\": \"Alexander\",\r\n    \"lastname\": \"Tester\",\r\n    \"totalprice\": 1,\r\n    \"depositpaid\": true,\r\n    \"bookingdates\": {\r\n        \"checkin\": \"2026-10-10\",\r\n        \"checkout\": \"2026-10-20\"\r\n    },\r\n    \"additionalneeds\": \"Breakfast\"\r\n}"
				},
				"url": {
					"raw": "{{RestfulBookerURL}}/booking",
					"host": [
						"{{RestfulBookerURL}}"
					],
					"path": [
						"booking"
					]
				}
			},
			"response": []
		},
		{
			"name": "Get Booking By ID",
