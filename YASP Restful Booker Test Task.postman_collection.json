				"disableBodyPruning": true
			},
			"request": {
				"method": "GET",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{RestfulBookerURL}}/booking/11",
					"host": [
						"{{RestfulBookerURL}}"
					],
					"path": [
						"booking",
						"11"
					]
				}
			},
			"response": []
		},
		{
			"name": "Update Booking PUT",
